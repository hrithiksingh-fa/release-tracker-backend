// Release Tracker data model.
//
// Hierarchy: Client -> Tracker -> Requirement -> LinkedWorkItem (1..N per Requirement).
//
// Stages/Workflows: Stage is a shared, reusable master list (e.g. "In Progress",
// "Done") -- the same Stage row can appear in many Workflows. A Workflow is an
// ordered sequence of Stages (via WorkflowStage, which also carries the position).
// Two kinds of Workflow exist:
//   - scope=PROJECT: exactly one, shared workflow governing which stage each
//     Client/"project" sits in (the outer Kanban board).
//   - scope=REQUIREMENT: one per Client, governing that client's Requirements.
//     Built by cloning a template (see isTemplate) or another client's workflow.
// Stage moves are fully manual (drag-and-drop / explicit action) -- ADO sync
// never changes a Client's or Requirement's stage on its own (see syncService).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      String   @default("admin")
  createdAt DateTime @default(now())
}

model Client {
  id     String @id @default(cuid())
  name   String @unique

  // Slack -- one channel per client (confirmed).
  slackChannelId   String?
  slackChannelName String?

  // Azure DevOps connection for this client's board.
  adoOrgUrl           String? // e.g. https://dev.azure.com/myorg
  adoProject          String?
  adoAreaPath         String?
  adoPatEncrypted     String? // encrypted at rest, see src/lib/crypto.ts
  // Which ADO [System.State] values count as "terminal / done" for this client's
  // board -- boards use different workflow names (Done, Closed, Resolved...).
  adoDoneStates       String[] @default(["Done"])

  // Where this client/"project" sits on the single outer PROJECT-scope workflow.
  // Set automatically to that workflow's first stage on client creation.
  currentStageId String?
  currentStage   WorkflowStage? @relation("ClientCurrentStage", fields: [currentStageId], references: [id])

  // This client's own REQUIREMENT-scope workflow (1:1, via Workflow.ownerClientId).
  // Cloned from a template or another client's workflow on client creation.
  requirementWorkflow Workflow?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trackers Tracker[]
}

model Stage {
  id          String   @id @default(cuid())
  name        String   @unique
  color       String? // hex, for the board UI
  isDoneStage Boolean  @default(false) // moving into this stage triggers release-note generation

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workflowStages WorkflowStage[]
}

enum WorkflowScope {
  PROJECT // the single shared workflow governing Client stage
  REQUIREMENT // one per client, governing that client's Requirements
}

model Workflow {
  id    String        @id @default(cuid())
  name  String
  scope WorkflowScope

  // True for the seeded PROJECT workflow and the seeded default REQUIREMENT
  // workflow -- these are the things "clone from" starts from when nothing
  // more specific (another client's workflow) is picked.
  isTemplate Boolean @default(false)

  // Set only for scope=REQUIREMENT workflows that belong to a specific client.
  // Null for the PROJECT workflow and for REQUIREMENT template workflows.
  ownerClientId String? @unique
  ownerClient   Client? @relation(fields: [ownerClientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stages WorkflowStage[]
}

model WorkflowStage {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  stageId    String
  stage      Stage    @relation(fields: [stageId], references: [id])
  position   Int

  requirements Requirement[]
  clientsHere  Client[]      @relation("ClientCurrentStage")

  @@unique([workflowId, stageId])
  @@unique([workflowId, position])
}

model Tracker {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requirements Requirement[]

  @@unique([clientId, name])
}

model Requirement {
  id        String  @id @default(cuid())
  trackerId String
  tracker   Tracker @relation(fields: [trackerId], references: [id], onDelete: Cascade)

  title       String
  description String?
  dueDate     DateTime?

  // Set only by an explicit stage-move action (drag-and-drop / API call) --
  // never by ADO sync, which only updates LinkedWorkItem state. Nullable: a
  // brand-new requirement has no stage until placed on the board.
  stageId String?
  stage   WorkflowStage? @relation(fields: [stageId], references: [id])
  doneAt  DateTime? // set when moved into a stage with isDoneStage=true, cleared if moved out

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  linkedWorkItems  LinkedWorkItem[]
  releaseNotes     ReleaseNote[]
  statusEvents     StatusEvent[]
  figmaReferences  FigmaReference[]
}

// A design file (or a specific frame/node in one) attached to a Requirement for
// reference. Figma access is org-level (one FIGMA_ACCESS_TOKEN, see env.ts), not
// per-client, since design files aren't scoped to a single client's ADO board.
model FigmaReference {
  id            String      @id @default(cuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  fileKey      String
  nodeId       String? // set when the link points at a specific frame, not the whole file
  fileName     String?
  url          String // the original Figma URL as pasted
  thumbnailUrl String?

  addedAt DateTime @default(now())
}

model LinkedWorkItem {
  id            String      @id @default(cuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  adoId Int // Azure DevOps work item id

  title                  String?
  descriptionText        String?
  acceptanceCriteriaText String?
  adoState               String?
  productOwner           String?
  assignedTo             String?

  lastSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requirementId, adoId])
}

enum ReleaseNoteStatus {
  DRAFT // just generated, sits in the review queue
  APPROVED // reviewed and approved by admin, queued to send
  SENT
  FAILED
}

model ReleaseNote {
  id            String      @id @default(cuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  // A Requirement can in principle be re-opened and re-completed later
  // (e.g. a follow-up work item gets linked after the fact) -- version tracks that.
  version Int               @default(1)
  status  ReleaseNoteStatus @default(DRAFT)

  category           String? // New Features / Enhancements / Bug Fixes
  screens            String[]
  problemStatement   String?
  objective          String?
  stepsToUse         String?
  acceptanceCriteria String?

  generatedAt DateTime  @default(now())
  approvedAt  DateTime?
  sentAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries DeliveryLog[]

  @@unique([requirementId, version])
}

model DeliveryLog {
  id            String      @id @default(cuid())
  releaseNoteId String
  releaseNote   ReleaseNote @relation(fields: [releaseNoteId], references: [id], onDelete: Cascade)

  channel      String // "slack"
  target       String // slack channel id
  status       String // "success" | "failed"
  errorMessage String?

  attemptedAt DateTime @default(now())
}

model StatusEvent {
  id            String      @id @default(cuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  scope String // "requirement_stage" | "linked_item"
  adoId Int? // set when scope = "linked_item"

  fromStatus String? // linked_item: ADO state name. requirement_stage: stage name.
  toStatus   String?
  actor      String? // "system:eod_sync" | "admin" | future user id

  occurredAt DateTime @default(now())
}

// One row per EOD sync run, for observability/debugging. Sync only updates
// LinkedWorkItem state now -- it never moves a Requirement's stage (that's a
// manual action, see requirements.ts's PATCH /requirements/:id/stage).
model SyncRun {
  id                 String    @id @default(cuid())
  startedAt          DateTime  @default(now())
  finishedAt         DateTime?
  clientsSynced      Int       @default(0)
  linkedItemsUpdated Int       @default(0)
  errors             String[]  @default([])
}
