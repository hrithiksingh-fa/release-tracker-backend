// Release Tracker data model.
//
// Hierarchy: Client -> Phase -> Requirement -> LinkedWorkItem (1..N per Requirement).
// ("Phase" was previously called "Tracker" -- a client's lifecycle stage, e.g.
// Onboarding / Scaling 1 / Scaling 2, each with its own set of requirements.)
//
// Stages/Workflows: Stage is a shared, reusable master list (e.g. "In Progress",
// "Done") -- the same Stage row can appear in many Workflows. A Workflow is an
// ordered sequence of Stages (via WorkflowStage, which also carries the position).
// Three kinds of Workflow exist, matching the three entities a workflow can be
// attached to:
//   - scope=CLIENT: exactly one, shared workflow governing which stage each
//     Client sits in (the outer Kanban board).
//   - scope=PHASE: one per Client, governing that client's Phases.
//   - scope=REQUIREMENT: one per Client, governing that client's Requirements.
// PHASE/REQUIREMENT workflows are built by cloning a template (isTemplate) or
// another client's workflow -- see workflowService.ts.
// Stage moves are fully manual (drag-and-drop / explicit action) -- ADO sync
// never changes anything's stage on its own (see syncService).
//
// Audit: AuditLog is a generic field-level change log (see auditService.ts),
// used for every edit to Client/Phase/Requirement -- not just stage moves.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      String   @default("admin")
  createdAt DateTime @default(now())
}

model Client {
  id   String @id @default(cuid())
  name String @unique

  description  String?
  productOwner String?
  deliveryDate DateTime?

  // Slack -- one channel per client (confirmed).
  slackChannelId   String?
  slackChannelName String?

  // Azure DevOps connection for this client's board (items pulled through it
  // are labeled "PBI" -- Product Backlog Item -- in the UI).
  adoOrgUrl       String? // e.g. https://dev.azure.com/myorg
  adoProject      String?
  adoAreaPath     String?
  adoPatEncrypted String? // encrypted at rest, see src/lib/crypto.ts
  // Which ADO [System.State] values count as "terminal / done" for this client's
  // board -- boards use different workflow names (Done, Closed, Resolved...).
  adoDoneStates   String[] @default(["Done"])

  modules Module[]

  // Where this client sits on the single outer CLIENT-scope workflow. Set
  // automatically to that workflow's first stage on client creation.
  currentStageId String?
  currentStage   WorkflowStage? @relation("ClientCurrentStage", fields: [currentStageId], references: [id])

  // This client's own PHASE-scope and REQUIREMENT-scope workflows (each 1:1).
  // Cloned from a template (or another client's workflow) on client creation,
  // or attached explicitly later from the admin panel.
  phaseWorkflowId String? @unique
  phaseWorkflow   Workflow? @relation("ClientPhaseWorkflow", fields: [phaseWorkflowId], references: [id])

  requirementWorkflowId String? @unique
  requirementWorkflow   Workflow? @relation("ClientRequirementWorkflow", fields: [requirementWorkflowId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  phases Phase[]
}

// A product module a client uses (e.g. "Reporting", "Bulk Upload") -- shown as
// a multi-select on the client form. Managed from the admin panel.
model Module {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients Client[]
}

model Stage {
  id          String  @id @default(cuid())
  name        String  @unique
  color       String? // hex, for the board UI
  isDoneStage Boolean @default(false) // moving into this stage triggers release-note generation (requirement stages only)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workflowStages WorkflowStage[]
}

enum WorkflowScope {
  CLIENT // the single shared workflow governing Client stage
  PHASE // one per client, governing that client's Phases
  REQUIREMENT // one per client, governing that client's Requirements
}

model Workflow {
  id    String        @id @default(cuid())
  name  String
  scope WorkflowScope

  // True for the seeded templates -- what "clone from" starts from when
  // nothing more specific (another client's workflow) is picked.
  isTemplate Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stages WorkflowStage[]

  // Reverse of Client.phaseWorkflowId / requirementWorkflowId -- which
  // client (if any) this workflow is attached to as their phase/requirement
  // workflow. At most one of these is ever set for a given Workflow row.
  clientUsingAsPhaseWorkflow       Client? @relation("ClientPhaseWorkflow")
  clientUsingAsRequirementWorkflow Client? @relation("ClientRequirementWorkflow")
}

model WorkflowStage {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  stageId    String
  stage      Stage    @relation(fields: [stageId], references: [id])
  position   Int

  requirements Requirement[]
  phasesHere   Phase[]       @relation("PhaseCurrentStage")
  clientsHere  Client[]      @relation("ClientCurrentStage")

  @@unique([workflowId, stageId])
  @@unique([workflowId, position])
}

model Phase {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name     String

  description  String?
  deliveryDate DateTime?

  // Set only by an explicit stage-move action, drawn from the client's own
  // PHASE-scope workflow. Nullable: exists briefly if that workflow has no
  // stages yet.
  stageId String?
  stage   WorkflowStage? @relation("PhaseCurrentStage", fields: [stageId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requirements Requirement[]

  @@unique([clientId, name])
}

enum RequirementPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Requirement {
  id      String @id @default(cuid())
  phaseId String
  phase   Phase  @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  title       String
  description String?
  priority    RequirementPriority @default(MEDIUM)

  // The original commitment vs. a later renegotiated date -- both tracked
  // (and both show up in the audit log when changed) rather than
  // overwriting one with the other.
  dueDate        DateTime?
  revisedDueDate DateTime?

  // Set only by an explicit stage-move action (drag-and-drop / API call) --
  // never by ADO sync, which only updates LinkedWorkItem state. Nullable: a
  // brand-new requirement has no stage until placed on the board.
  stageId String?
  stage   WorkflowStage? @relation(fields: [stageId], references: [id])
  doneAt  DateTime? // set when moved into a stage with isDoneStage=true, cleared if moved out

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  linkedWorkItems LinkedWorkItem[]
  releaseNotes    ReleaseNote[]
  figmaReferences FigmaReference[]
}

// A design file (or a specific frame/node in one) attached to a Requirement for
// reference. Figma access is org-level (one FIGMA_ACCESS_TOKEN, see env.ts), not
// per-client, since design files aren't scoped to a single client's ADO board.
model FigmaReference {
  id            String      @id @default(cuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  fileKey      String
  nodeId       String? // set when the link points at a specific frame, not the whole file
  fileName     String?
  url          String // the original Figma URL as pasted
  thumbnailUrl String?

  addedAt DateTime @default(now())
}

// A PBI (Product Backlog Item) linked from Azure DevOps -- a Requirement can
// have several (see the two-way ADO integration).
model LinkedWorkItem {
  id            String      @id @default(cuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  adoId Int // Azure DevOps work item id

  title                  String?
  descriptionText        String?
  acceptanceCriteriaText String?
  adoState               String?
  productOwner           String?
  assignedTo             String?

  lastSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requirementId, adoId])
}

enum ReleaseNoteStatus {
  DRAFT // just generated, sits in the review queue
  APPROVED // reviewed and approved by admin, queued to send
  SENT
  FAILED
}

model ReleaseNote {
  id            String      @id @default(cuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  // A Requirement can in principle be re-opened and re-completed later
  // (e.g. a follow-up work item gets linked after the fact) -- version tracks that.
  version Int               @default(1)
  status  ReleaseNoteStatus @default(DRAFT)

  category           String? // New Features / Enhancements / Bug Fixes
  screens            String[]
  problemStatement   String?
  objective          String?
  stepsToUse         String?
  acceptanceCriteria String?

  generatedAt DateTime  @default(now())
  approvedAt  DateTime?
  sentAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries DeliveryLog[]

  @@unique([requirementId, version])
}

model DeliveryLog {
  id            String      @id @default(cuid())
  releaseNoteId String
  releaseNote   ReleaseNote @relation(fields: [releaseNoteId], references: [id], onDelete: Cascade)

  channel      String // "slack"
  target       String // slack channel id
  status       String // "success" | "failed"
  errorMessage String?

  attemptedAt DateTime @default(now())
}

// Generic field-level audit trail -- every edit to Client/Phase/Requirement
// (and stage moves, and linked-item ADO state changes) writes one row here.
// entityType is a plain string ("client" | "phase" | "requirement" |
// "linked_item") rather than an enum so new entity types don't need a migration.
model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  field      String
  oldValue   String?
  newValue   String?
  actor      String   @default("admin") // "system:eod_sync" | "admin" | future user id
  occurredAt DateTime @default(now())

  @@index([entityType, entityId, occurredAt])
}

// One row per EOD sync run, for observability/debugging. Sync only updates
// LinkedWorkItem state now -- it never moves anything's stage (that's a
// manual action, see requirements.ts's PATCH /requirements/:id/stage).
model SyncRun {
  id                 String    @id @default(cuid())
  startedAt          DateTime  @default(now())
  finishedAt         DateTime?
  clientsSynced      Int       @default(0)
  linkedItemsUpdated Int       @default(0)
  errors             String[]  @default([])
}
