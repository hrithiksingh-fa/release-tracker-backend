# Copy to .env and fill in.

# Postgres (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://tracker:tracker@localhost:5432/release_tracker?schema=public"

PORT=4000

# 32-byte key (as hex) used to encrypt stored ADO PATs / Slack tokens at rest.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENCRYPTION_KEY=

# Anthropic API key, used for the plain-language release-note rewrite step.
# If unset, the rewrite step falls back to a plain heuristic (no LLM call) so
# the pipeline still runs end-to-end without it.
ANTHROPIC_API_KEY=

# Slack bot token (xoxb-...) with chat:write scope, invited to every client channel.
SLACK_BOT_TOKEN=

# EOD sync schedule, cron syntax, server-local time. Default: 23:00 every day.
EOD_SYNC_CRON="0 23 * * *"

# Simple shared-secret auth for the single admin user (see src/middleware/auth.ts).
# Sent as `Authorization: Bearer <ADMIN_API_TOKEN>` by the frontend.
ADMIN_API_TOKEN=change-me
